<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>OxideMD Third-Party Licenses</title>
    <style>
        :root { color-scheme: light dark; }
        body {
            font-family: system-ui, sans-serif;
            line-height: 1.5;
            margin: 0;
        }
        main {
            margin: 0 auto;
            max-width: 960px;
            padding: 2rem;
        }
        pre {
            border: 1px solid #8886;
            border-radius: 0.4rem;
            overflow-x: auto;
            padding: 1rem;
            white-space: pre-wrap;
        }
    </style>
</head>
<body>
<main>
