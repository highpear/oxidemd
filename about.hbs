    <h2>License overview</h2>
    <ul>
        {{#each overview}}
        <li><a href="#{{id}}">{{name}}</a> ({{count}} components)</li>
        {{/each}}
    </ul>

    <h2>Notices and license texts</h2>
    {{#each licenses}}
    <section>
        {{#if first_of_kind}}
        <h3 id="{{id}}">{{name}}</h3>
        {{/if}}
        <p>Used by:</p>
        <ul>
            {{#each used_by}}
            <li>
                <a href="{{#if crate.repository}}{{crate.repository}}{{else}}https://crates.io/crates/{{crate.name}}{{/if}}">
                    {{crate.name}} {{crate.version}}
                </a>
            </li>
            {{/each}}
        </ul>
        <pre>{{text}}</pre>
    </section>
    {{/each}}
</main>
</body>
</html>
